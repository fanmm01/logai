{
  "name": "autocombat-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../scripts/build_frontends.cjs",
    "test": "node ../scripts/test_frontend.cjs",
    "test:browser": "node ../scripts/test_frontend.cjs --browser",
    "build:app": "tsc --noEmit && vite build",
    "test:story": "vitest run --config vitest.story.config.ts",
    "test:story:coverage": "vitest run --config vitest.story.config.ts --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.1.0"
  }
}
